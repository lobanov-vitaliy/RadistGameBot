# Токен от @BotFather
BOT_TOKEN=

# OpenAI: пересказ патчноутов на русском и шутка к курсу голды. Без ключа бот тоже работает
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Рассуждения модели: none — дешевле всего; для gpt-5-mini используй minimal
OPENAI_REASONING_EFFORT=none

# YouTube Data API v3 (бесплатный ключ в Google Cloud Console). Без ключа видео выключены
YOUTUBE_API_KEY=
# Что искать на YouTube, через запятую
YOUTUBE_KEYWORDS=wardogs funny,wardogs moments,wardogs

# Расписания (cron, UTC). Значения по умолчанию:
# GOLD_CRON=15 0 * * *
# NEWS_CRON=0 * * * *
# VIDEO_CRON=30 * * * *

# Где хранить состояние (что уже опубликовано)
# DATA_DIR=data
